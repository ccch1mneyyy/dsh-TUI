{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "lib/types",
    // The ported Ink core is third-party code written against looser flags;
    // keep the vendored renderer compiling without a rewrite.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src"]
}
