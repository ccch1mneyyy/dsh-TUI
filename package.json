{
  "name": "@deepseek-ai/dsh-cc-tui",
  "version": "0.1.0",
  "description": "Claude Code style interactive TUI front door for DeepSeek Harness agents, built on the ported Ink core.",
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "tui": "node --import tsx/esm scripts/run.ts",
    "smoke": "node --import tsx/esm scripts/smoke.tsx"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-commands": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "auto-bind": "^4.0.0 || ^5.0.0",
    "bidi-js": "^1.0.0",
    "chalk": "^5.0.0",
    "cli-boxes": "^3.0.0 || ^4.0.0",
    "cli-highlight": "^2.1.11",
    "code-excerpt": "^3.0.0 || ^4.0.0",
    "emoji-regex": "^10.0.0",
    "figures": "^6.1.0",
    "get-east-asian-width": "^1.0.0",
    "highlight.js": "^11.11.1",
    "indent-string": "^5.0.0",
    "lodash-es": "^4.17.0",
    "marked": "^18.0.7",
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "schemastery": "^3.18.0",
    "semver": "^7.0.0",
    "signal-exit": "^4.0.0",
    "stack-utils": "^2.0.0",
    "strip-ansi": "^7.0.0",
    "supports-hyperlinks": "^3.0.0",
    "type-fest": "^4.0.0",
    "usehooks-ts": "^3.1.0",
    "wrap-ansi": "^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-spine-demo": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^",
    "@deepseek-ai/dsh-llm-deepseek": "workspace:^",
    "@deepseek-ai/dsh-subprocess-local": "workspace:^",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-reconciler": "^0.33.0",
    "@types/semver": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  }
