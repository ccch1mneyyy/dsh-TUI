LangString ConfirmKernelKeep ${LANG_SIMPCHINESE} "保留已安装的兼容内核"
LangString ConfirmKernelReplace ${LANG_ENGLISH} "install or update to"
LangString ConfirmKernelReplace ${LANG_SIMPCHINESE} "安装或更新至"
LangString ConfirmCommands ${LANG_ENGLISH} "Commands (npm prefix)"
LangString ConfirmCommands ${LANG_SIMPCHINESE} "命令位置（npm prefix）"
LangString ConfirmMeta ${LANG_ENGLISH} "Installer metadata"
LangString ConfirmMeta ${LANG_SIMPCHINESE} "安装器元数据"
LangString ConfirmProfile ${LANG_ENGLISH} "Profile"
LangString ConfirmProfile ${LANG_SIMPCHINESE} "Profile 目录"
