{
	"name": "@deepseek-harness-tui/pi-tui",
	"version": "0.84.2-dsh.0",
	"private": true,
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"files": [
		"dist/**/*",
		"native/win32/prebuilds/**/*.node",
		"native/win32/src/**/*.c",
		"native/win32/build.mjs",
		"native/win32/README.md",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/src/**/*.c",
		"native/darwin/build.sh",
		"native/darwin/README.md",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.5"
	},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"@xterm/headless": "5.5.0",
		"chalk": "5.6.2",
		"shx": "0.4.0"
	},
	"dsh": {
		"upstream": {
			"repository": "https://github.com/earendil-works/pi",
			"commit": "086c32e74530564922d011ade23ff582c9d63116",
			"version": "0.84.2"
		}
	}
}
