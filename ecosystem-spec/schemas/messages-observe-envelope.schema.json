{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dsh.community/schemas/messages-observe-envelope-0.15.json",
  "title":"messages.observe envelope v0.15",
  "type":"object","additionalProperties":false,
  "required":["eventType","eventVersion","eventId","scope","sequence","privacyClass","summary","payload"],
  "properties":{
    "eventType":{"const":"messages.observe"},
    "eventVersion":{"const":"0.15"},
    "eventId":{"type":"string","pattern":"^[A-Za-z0-9._:-]+$"},
    "scope":{"type":"string","minLength":1,"maxLength":256},
    "sequence":{"type":"integer","minimum":0},
    "privacyClass":{"enum":["public","internal","sensitive"]},
    "summary":{"type":"string","maxLength":1024},
    "payload":{"type":"object","additionalProperties":false,"required":["kind","content"],"properties":{
      "kind":{"type":"string","enum":["message.created","message.received","message.sent"]},
      "messageId":{"type":"string","maxLength":256},
      "author":{"type":"string","maxLength":256},
      "content":{"type":"array","items":{"$ref":"#/$defs/contentBlock"},"minItems":1},
      "truncated":{"type":"boolean"}
    }}
  },
  "$defs":{
    "contentBlock":{
      "type":"object","additionalProperties":false,"required":["type"],
      "description":"Message content aligned to MCP ContentBlock (text/image subset). The exact field boundary tracks community v0.15 §9 Q3 and will be narrowed once upstream settles.",
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["type","text"],"properties":{"type":{"const":"text"},"text":{"type":"string","maxLength":262144}}},
        {"type":"object","additionalProperties":false,"required":["type","data","mimeType"],"properties":{"type":{"const":"image"},"data":{"type":"string"},"mimeType":{"type":"string","pattern":"^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"}}}
      ]
    }
  }
}
