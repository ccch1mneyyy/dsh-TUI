{
  "name":"commands","version":"0.15","kind":"capability",
  "coordinates":{"apiVersion":"commands.dsh/v1alpha1","kind":"Command"},
  "caller":"presentation or control plane through one invocation",
  "permissions":["commands.invoke"],
  "descriptor":{"required":["id","title"],"optional":["description"]},
  "input":{"arguments":"JSON object"},
  "output":{"status":"ok|error","value":"JSON value without ephemeral secrets","errorCode":"string when status=error"},
  "errors":["COMMAND_NOT_FOUND","DUPLICATE_CONTRIBUTION_ID","PERMISSION_NOT_GRANTED","COMMAND_FAILED","INVOCATION_CANCELLED","INVOCATION_DEADLINE_EXCEEDED"],
  "concurrency":"host may execute independent command invocations concurrently",
  "timeout":"invocation deadline when supplied; otherwise host policy",
  "cleanup":"handler registration is released on deactivate",
  "privacyClass":"internal",
  "securityBoundary":false,
  "limits":{"tree":false,"interactivePrompt":false,"streaming":false}
}
