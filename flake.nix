{
  description = "dsh-TUI with a pinned DeepSeek Harness runtime";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs = { self, nixpkgs }:
    let
      systems = [ "x86_64-linux" "aarch64-linux" "aarch64-darwin" ];
      forAllSystems = nixpkgs.lib.genAttrs systems;
      # Minimal self-contained TeX Live for TikZ rendering: scheme-basic plus the
      # packages loaded by the renderer template, Computer Modern Type1 outlines
      # (cm-super) and dvisvgm. mylatexformat turns the exact bundled preamble
      # into a preloaded format so warm compiles skip package loading.
      tikzFor = system:
        let
          pkgs = import nixpkgs { inherit system; };
          texlive = pkgs.texlive.combine {
            inherit (pkgs.texlive)
              scheme-basic pgf tikz-cd pgfplots geometry xcolor amsmath amsfonts
              tools mathtools multirow makecell cm-super dvisvgm mylatexformat;
          };
          # This preamble must stay a superset of the renderer's fixed template
          # (src/tikz/source.ts): with the format loaded mylatexformat skips the
          # document's own preamble, so every package the renderer can load is
          # preloaded here. `\usetikzlibrary` still works after
          # `\begin{document}`, which is how a figure requests extra libraries.
          # The format is generated by the bundled latex, which is also the one
          # the launcher puts on PATH.
          tikzFormat = pkgs.runCommand "dsh-tui-tikz-format" {
            nativeBuildInputs = [ texlive ];
          } ''
            export HOME="$TMPDIR" TEXMFVAR="$TMPDIR/texmf-var" TEXMFCONFIG="$TMPDIR/texmf-config" TEXMFHOME="$TMPDIR/texmf-home"
            cat > preamble.tex <<'TEX'
            \documentclass{article}
            \usepackage[paperwidth=4000pt,paperheight=4000pt,margin=0pt]{geometry}
            \usepackage{amsmath,amssymb}
            \usepackage{mathtools}
            \usepackage{bm}
            \usepackage{xcolor}
            \usepackage{array}
            \usepackage{multirow}
            \usepackage{makecell}
            \usepackage{tikz}
            \usepackage{tikz-cd}
            \usepackage{pgfplots}
            \pgfplotsset{compat=1.18}
            \usetikzlibrary{arrows.meta,positioning,calc,automata,shapes.geometric}
            \begin{document}
            TEX
            latex -ini -interaction=nonstopmode -halt-on-error -no-shell-escape \
              -jobname=dsh-tikz "&latex" mylatexformat.ltx preamble.tex
            install -Dm644 dsh-tikz.fmt "$out/share/dsh-tui/tikz.fmt"
          '';
          # Compile the renderer's document shape the normal way and with the
          # preloaded format, vectorize both with dvisvgm, and require real
          # paths (no embedded fonts) from both. A full document is used on
          # purpose: mylatexformat skips everything up to \begin{document}.
          test = pkgs.runCommand "dsh-tui-tikz-test" {
            nativeBuildInputs = [ texlive pkgs.coreutils ];
          } ''
            export HOME="$TMPDIR" TEXMFVAR="$TMPDIR/texmf-var" TEXMFCONFIG="$TMPDIR/texmf-config" TEXMFHOME="$TMPDIR/texmf-home"
            cat > figure.tex <<'TEX'
            \documentclass{article}
            \usepackage[paperwidth=4000pt,paperheight=4000pt,margin=0pt]{geometry}
            \usepackage{tikz}
            \usepackage{tikz-cd}
            \usepackage{pgfplots}
            \pgfplotsset{compat=1.18}
            \usetikzlibrary{arrows.meta,positioning,calc,automata,shapes.geometric}
            \begin{document}
            \thispagestyle{empty}
            \usetikzlibrary{decorations.pathmorphing}
            \begin{tikzcd} A \arrow[r, "f"] \arrow[d] & B \arrow[d] \\ C \arrow[r] & D \end{tikzcd}
            \begin{tikzpicture}[>=Stealth]
              \node[state] (a) {A};
              \draw[decorate, decoration=snake] (0,0) -- (1,0);
            \end{tikzpicture}
            \begin{tikzpicture}\begin{axis}\addplot {x^2};\end{axis}\end{tikzpicture}
            \end{document}
            TEX
            latex -no-shell-escape -interaction=nonstopmode -halt-on-error figure.tex
            dvisvgm --no-fonts -b min -o normal.svg figure.dvi
            latex -no-shell-escape -interaction=nonstopmode -halt-on-error \
              -fmt=${tikzFormat}/share/dsh-tui/tikz.fmt figure.tex
            dvisvgm --no-fonts -b min -o format.svg figure.dvi
            for svg in normal.svg format.svg; do
              test -s "$svg"
              grep -q '<path' "$svg"
              ! grep -qE '<font|<image' "$svg"
            done
            # Body-only document proving the format preloads every package a
            # figure may request: amsmath/mathtools (\coloneqq), bm (\bm),
            # amsfonts/amssymb (\mathbb), array (>{}), multirow, makecell.
            cat > preloaded.tex <<'TEX'
            \begin{document}
            $a \coloneqq \bm{x}+\frac{1}{2}$ \qquad $\mathbb{R}$
            \begin{tabular}{>{\bfseries}l c}
            \makecell{one\\two} & \multirow{2}{*}{x}
            \end{tabular}
            \end{document}
            TEX
            latex -no-shell-escape -interaction=nonstopmode -halt-on-error \
              -fmt=${tikzFormat}/share/dsh-tui/tikz.fmt preloaded.tex
            test -s preloaded.dvi
            install -Dm644 format.svg "$out/share/dsh-tui/tikz-test.svg"
          '';
        in { inherit texlive tikzFormat test; };
      packageFor = system: { allowUserPlugins ? false, withTikz ? true }:
        let
          pkgs = import nixpkgs { inherit system; };
          tikz = tikzFor system;
          texBin = nixpkgs.lib.optionalString withTikz "${tikz.texlive}/bin";
          tikzFormatFile = nixpkgs.lib.optionalString withTikz "${tikz.tikzFormat}/share/dsh-tui/tikz.fmt";
          # Bundled skill root: the TikZ prompt hint plus the package's normal
          # guide skill. Relative to the wrapper's package root; the directory is
          # only installed when withTikz is on. The launcher only fills
          # DSH_BUNDLED_SKILL_DIR when the user has not set it.
          tikzSkillDir = nixpkgs.lib.optionalString withTikz "share/dsh-tui/skills";
          nodePlatforms = {
            x86_64-linux = { platform = "linux-x64"; hash = "55aa7153f9d88f28d765fcdad5ae6945b5c0f98a36881703817e4c450fa76742"; };
            aarch64-linux = { platform = "linux-arm64"; hash = "58c9520501f6ae2b52d5b210444e24b9d0c029a58c5011b797bc1fe7105886f6"; };
            aarch64-darwin = { platform = "darwin-arm64"; hash = "4477b9f78efb77744cf5eb57a0e9594dba66466b38b4e93fa9f35cb907a095a6"; };
          }.${system};
          node = pkgs.stdenvNoCC.mkDerivation {
            pname = "dsh-tui-node";
            version = "24.18.0";
            src = pkgs.fetchurl {
              url = "https://nodejs.org/dist/v24.18.0/node-v24.18.0-${nodePlatforms.platform}.tar.xz";
              sha256 = nodePlatforms.hash;
            };
            nativeBuildInputs = pkgs.lib.optionals pkgs.stdenv.hostPlatform.isLinux [ pkgs.patchelf ];
            dontBuild = true;
            dontStrip = true;
            installPhase = ''
              mkdir -p "$out/bin" "$out/share/licenses/node"
              cp bin/node "$out/bin/node"
              cp LICENSE "$out/share/licenses/node/LICENSE"
            '' + pkgs.lib.optionalString pkgs.stdenv.hostPlatform.isLinux ''
              patchelf --no-sort \
                --set-interpreter ${pkgs.stdenv.cc.bintools.dynamicLinker} \
                --set-rpath ${pkgs.lib.makeLibraryPath [ pkgs.stdenv.cc.cc.lib pkgs.stdenv.cc.cc.libgcc ]} \
                "$out/bin/node"
            '';
          };
          pnpm = pkgs.pnpm_11;
          runtimeSrc = pkgs.runCommand "dsh-tui-runtime-src" { } ''
            mkdir -p "$out"
            cp ${./nix/runtime-package.json} "$out/package.json"
            cp ${./nix/runtime-pnpm-lock.yaml} "$out/pnpm-lock.yaml"
            cp ${./nix/runtime-pnpm-workspace.yaml} "$out/pnpm-workspace.yaml"
          '';
          runtime = pkgs.stdenvNoCC.mkDerivation {
            pname = "dsh-tui-runtime";
            version = "0.17.0-dsh-0.2.1-rc.3";
            src = runtimeSrc;
            nativeBuildInputs = [ node pnpm pkgs.pnpmConfigHook ];
            pnpmDeps = pkgs.fetchPnpmDeps {
              pname = "dsh-tui-runtime-deps";
              version = "0.17.0";
              src = runtimeSrc;
              pnpm = pkgs.pnpm_11;
              pnpmWorkspaces = [ "." ];
              fetcherVersion = 5;
              hash = "sha256-zYHJ7ngS0rwAap428aR1P/QjiUBkA0K+uYZpcWG7pQg=";
            };
            installPhase = ''
              runHook preInstall
              node node_modules/@deepseek-ai/dsh-subprocess-local/scripts/ensure-spawn-helper.mjs
              mkdir -p "$out/lib/dsh-tui"
              cp -a node_modules "$out/lib/dsh-tui/"
              runHook postInstall
            '';
          };
          package = pkgs.stdenvNoCC.mkDerivation {
            pname = "dsh-tui";
            version = "0.17.0";
            nativeBuildInputs = [ pkgs.makeWrapper ];
            dontUnpack = true;
            dontBuild = true;
            installPhase = ''
              runHook preInstall
              mkdir -p "$out/bin" "$out/libexec"
              cp ${./nix/launch.mjs} "$out/libexec/launch.mjs"
              substituteInPlace "$out/libexec/launch.mjs" \
                --replace-fail '@runtime@' '${runtime}' \
                --replace-fail '@allowUserPlugins@' '${if allowUserPlugins then "true" else "false"}' \
                --replace-fail '@node@' '${node}' \
                --replace-fail '@pnpm@' '${pnpm}' \
                --replace-fail '@coreutils@' '${pkgs.coreutils}' \
                --replace-fail '@texBin@' '${texBin}' \
                --replace-fail '@tikzFormat@' '${tikzFormatFile}' \
                --replace-fail '@tikzSkillDir@' '${tikzSkillDir}'
              ${pkgs.lib.optionalString withTikz ''
              mkdir -p "$out/share/dsh-tui/skills"
              cp -r ${./nix/skills/tikz-commutative} "$out/share/dsh-tui/skills/tikz-commutative"
              test -s "$out/share/dsh-tui/skills/tikz-commutative/SKILL.md"
              guide=${runtime}/lib/dsh-tui/node_modules/@deepseek-harness-tui/dsh-tui/guide/dsh-tui-guide
              test -f "$guide/SKILL.md"
              ln -s "$guide" "$out/share/dsh-tui/skills/dsh-tui-guide"
              ''}
              makeWrapper ${node}/bin/node "$out/bin/dsh-tui" --add-flags "$out/libexec/launch.mjs"
              ln -s dsh-tui "$out/bin/dst"
              ln -s ${runtime}/lib/dsh-tui/node_modules/@deepseek-ai/dsh/lib/bin.js "$out/bin/dsh"
              runHook postInstall
            '';
            meta = {
              description = "Terminal UI for DeepSeek Harness (bundled DSH 0.2.1-rc.3)"
                + pkgs.lib.optionalString allowUserPlugins ", allows user plugin installation";
              homepage = "https://github.com/ccch1mneyyy/dsh-TUI";
              license = pkgs.lib.licenses.mit;
              mainProgram = "dsh-tui";
              platforms = systems;
            };
            passthru = { inherit runtime node pnpm allowUserPlugins withTikz; }
              // pkgs.lib.optionalAttrs withTikz { inherit (tikz) texlive tikzFormat; };
            doInstallCheck = true;
            installCheckPhase = ''
              ${node}/bin/node ${./nix/verify.mjs} "$out" ${runtime} ${pkgs.runtimeShell} ${pnpm}/bin/pnpm ${pkgs.lib.optionalString allowUserPlugins "--allow-user-plugins"}
            '';
          };
        in package;
      homeManagerModule = { config, lib, pkgs, ... }:
        let cfg = config.programs.dsh-tui;
        in {
          options.programs.dsh-tui = {
            enable = lib.mkEnableOption "dsh-TUI with bundled DSH";
            allowUserPlugins = lib.mkOption {
              type = lib.types.bool;
              default = false;
              description = ''
                Allow installing DSH plugins into the dsh-tui profile with
                `/plugin install` or `dsh plugin`. The profile becomes a
                writable overlay over the Nix-pinned runtime; it is reseeded
                whenever the Nix package or bundled runtime changes, so
                installed plugins are removed on a rebuild that changes the
                launcher or runtime. Sessions,
                credentials and cordis.patch.yml are kept.
              '';
            };
            withTikz = lib.mkOption {
              type = lib.types.bool;
              default = true;
              description = ''
                Bundle the minimal TeX Live closure, preloaded format and the
                `tikz-commutative` DSH skill used for TikZ rendering, and select
                the matching package variant. Set to false only when `latex` and
                `dvisvgm` are provided elsewhere on PATH; the Nix package is
                self-contained otherwise and installs the skill by default.
              '';
            };
            package = lib.mkOption {
              type = lib.types.package;
              default =
                let
                  system = pkgs.stdenv.hostPlatform.system;
                  variant = name: self.packages.${system}.${name};
                in
                  if cfg.allowUserPlugins
                  then variant (if cfg.withTikz then "user-plugins" else "user-plugins-no-tikz")
                  else variant (if cfg.withTikz then "default" else "no-tikz");
              defaultText = lib.literalExpression "inputs.dsh-tui.packages.\${pkgs.stdenv.hostPlatform.system}.default";
              description = "The bundled dsh-TUI package; `allowUserPlugins` and `withTikz` select the writable-profile and TeX-closure variants unless this is overridden.";
            };
            dshHome = lib.mkOption {
              type = lib.types.nullOr lib.types.str;
              default = null;
              example = "\${config.home.homeDirectory}/.dsh";
              description = "Optional DSH home directory.";
            };
          };
          config = lib.mkIf cfg.enable {
            home.packages = [ cfg.package ];
            home.sessionVariables = lib.optionalAttrs (cfg.dshHome != null) { DSH_HOME = cfg.dshHome; };
          };
        };
      nixosModule = { config, lib, pkgs, ... }:
        let cfg = config.programs.dsh-tui;
        in {
          options.programs.dsh-tui = {
            enable = lib.mkEnableOption "dsh-TUI with bundled DSH";
            allowUserPlugins = lib.mkOption {
              type = lib.types.bool;
              default = false;
              description = ''
                Allow installing DSH plugins into the dsh-tui profile with
                `/plugin install` or `dsh plugin`. The profile becomes a
                writable overlay over the Nix-pinned runtime; it is reseeded
                whenever the Nix package or bundled runtime changes, so
                installed plugins are removed on a rebuild that changes the
                launcher or runtime. Sessions,
                credentials and cordis.patch.yml are kept.
              '';
            };
            withTikz = lib.mkOption {
              type = lib.types.bool;
              default = true;
              description = ''
                Bundle the minimal TeX Live closure, preloaded format and the
                `tikz-commutative` DSH skill used for TikZ rendering, and select
                the matching package variant. Set to false only when `latex` and
                `dvisvgm` are provided elsewhere on PATH; the Nix package is
                self-contained otherwise and installs the skill by default.
              '';
            };
            package = lib.mkOption {
              type = lib.types.package;
              default =
                let
                  system = pkgs.stdenv.hostPlatform.system;
                  variant = name: self.packages.${system}.${name};
                in
                  if cfg.allowUserPlugins
                  then variant (if cfg.withTikz then "user-plugins" else "user-plugins-no-tikz")
                  else variant (if cfg.withTikz then "default" else "no-tikz");
              defaultText = lib.literalExpression "inputs.dsh-tui.packages.\${pkgs.stdenv.hostPlatform.system}.default";
              description = "The bundled dsh-TUI package; `allowUserPlugins` and `withTikz` select the writable-profile and TeX-closure variants unless this is overridden.";
            };
          };
          config = lib.mkIf cfg.enable { environment.systemPackages = [ cfg.package ]; };
        };
    in {
      packages = forAllSystems (system: {
        default = packageFor system { allowUserPlugins = false; };
        dsh-tui = packageFor system { allowUserPlugins = false; };
        user-plugins = packageFor system { allowUserPlugins = true; };
        no-tikz = packageFor system { withTikz = false; };
        user-plugins-no-tikz = packageFor system { allowUserPlugins = true; withTikz = false; };
      });
      devShells = forAllSystems (system:
        let pkgs = import nixpkgs { inherit system; };
        in { default = pkgs.mkShell { packages = [ pkgs.nodejs-slim_24 pkgs.pnpm_11 ]; }; });
      apps = forAllSystems (system: {
        default = {
          type = "app";
          program = "${self.packages.${system}.default}/bin/dsh-tui";
          meta.description = "dsh-TUI with bundled DeepSeek Harness";
        };
      });
      checks = forAllSystems (system: {
        runtime = self.packages.${system}.default;
        user-plugins = self.packages.${system}.user-plugins;
        tikz = (tikzFor system).test;
      });
      homeManagerModules.default = homeManagerModule;
      homeManagerModules.dsh-tui = homeManagerModule;
      nixosModules.default = nixosModule;
      nixosModules.dsh-tui = nixosModule;
    };
}
