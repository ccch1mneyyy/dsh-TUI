{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dsh.community/schemas/effect-ledger-record-0.15.json",
  "title":"DSH Effect Ledger Record v0.15",
  "type":"object","additionalProperties":false,
  "required":["ledgerVersion","sequence","timestamp","pluginId","activationInstance","runtimeGenerationId","operation","resource","result"],
  "properties":{
    "ledgerVersion":{"const":"0.15"},"sequence":{"type":"integer","minimum":0},"timestamp":{"type":"string","format":"date-time"},
    "pluginId":{"type":"string","minLength":1,"maxLength":128},"activationInstance":{"type":"string","minLength":1,"maxLength":128},"runtimeGenerationId":{"type":"string","pattern":"^[A-Za-z0-9._:-]+$","maxLength":128},
    "operation":{"enum":["create","bind","replace","release","cleanup-failed"]},
    "resource":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"type":"string","minLength":1,"maxLength":64},"id":{"type":"string","minLength":1,"maxLength":128}}},
    "replaces":{"type":"object","additionalProperties":false,"properties":{"resourceId":{"type":"string","minLength":1,"maxLength":128},"activationInstance":{"type":"string","minLength":1,"maxLength":128}}},
    "result":{"enum":["applied","pending","failed"]},"errorCode":{"type":"string","minLength":1,"maxLength":64},
    "valueDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
  }
}
