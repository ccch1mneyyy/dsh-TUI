{
  "$schema": "urn:dsh-tui:host-descriptor:0.15",
  "hostId": "dsh-tui.private-example",
  "hostVersion": "0.1.0-experimental",
  "facetApiVersions": [
    "v1alpha1"
  ],
  "contracts": [
    {
      "apiVersion": "storage.dsh/v1alpha1",
      "kind": "LocalStorage",
      "definition": {
        "source": "dsh-std",
        "package": "@dsh-std/storage"
      },
      "permissions": [
        "storage.local.read",
        "storage.local.write"
      ]
    },
    {
      "apiVersion": "commands.dsh/v1alpha1",
      "kind": "Command",
      "definition": {
        "source": "dsh-std",
        "package": "@dsh-std/command"
      },
      "permissions": [
        "commands.invoke"
      ]
    },
    {
      "apiVersion": "messages.dsh/v1alpha1",
      "kind": "MessageObserver",
      "definition": {
        "source": "dsh-std",
        "package": "@dsh-std/messages"
      },
      "permissions": [
        "messages.observe.read"
      ]
    },
    {
      "apiVersion": "tui.dsh/v1alpha1",
      "kind": "DecisionEvents",
      "definition": {
        "source": "tui-profile",
        "profileHash": "sha256:56440dde1b00c210b22761a0cba139ce0a20207330567777cebe1e48b494ceb0"
      },
      "permissions": []
    }
  ],
  "runtime": {
    "location": "remote",
    "generationId": "example-generation-1",
    "headless": true,
    "remoteAttach": true
  },
  "trustLevel": "trusted-in-process",
  "platform": {
    "os": "linux",
    "arch": "x64",
    "node": ">=22.19"
  }
}
