{
  "$schema":"https://dsh.community/schemas/dsh-plugin-0.15.json",
  "id":"com.example.partial",
  "name":"Uncovered Command Plugin",
  "version":"0.1.0",
  "manifestVersion":"0.15",
  "facets":{"host":{"entry":"dist/main.js","apiVersion":"v1alpha1"}},
  "requires":{"contracts":[
    {"apiVersion":"commands.dsh/v1alpha1","kind":"Command"}
  ]},
  "permissions":[{"name":"commands.invoke","scope":"com.example.partial.*","reason":"invoke the declared commands"}],
  "contributes":{"commands":[{"id":"com.example.partial.run","title":"Run"},{"id":"org.example.elsewhere.run","title":"Outside the namespace"}]},
  "subscriptions":[],
  "license":"MIT",
  "source":{"repository":"https://example.com/partial"}
}
