{
  "$schema": "urn:dsh-tui:host-descriptor:0.15",
  "hostId": "dsh-tui-old-facet",
  "hostVersion": "0.1.0-experimental",
  "facetApiVersions": [
    "v2alpha1"
  ],
  "contracts": [
    {
      "apiVersion": "commands.dsh/v1alpha1",
      "kind": "Command",
      "definition": {
        "source": "dsh-std",
        "package": "@dsh-std/command"
      },
      "permissions": [
        "commands.invoke"
      ]
    }
  ],
  "runtime": {
    "location": "local",
    "generationId": "old-facet-1",
    "headless": true
  },
  "trustLevel": "trusted-in-process",
  "platform": {
    "os": "linux",
    "arch": "x64"
  }
}