{
  "$schema": "urn:dsh-tui:host-descriptor:0.15",
  "hostId": "dsh-tui-minimal",
  "hostVersion": "0.1.0-experimental",
  "facetApiVersions": [
    "v1alpha1"
  ],
  "contracts": [
    {
      "apiVersion": "storage.dsh/v1alpha1",
      "kind": "LocalStorage",
      "definition": {
        "source": "dsh-std",
        "package": "@dsh-std/storage"
      },
      "permissions": [
        "storage.local.read",
        "storage.local.write"
      ]
    },
    {
      "apiVersion": "commands.dsh/v1alpha1",
      "kind": "Command",
      "definition": {
        "source": "dsh-std",
        "package": "@dsh-std/command"
      },
      "permissions": [
        "commands.invoke"
      ]
    }
  ],
  "runtime": {
    "location": "local",
    "generationId": "minimal-1",
    "headless": true
  },
  "trustLevel": "trusted-in-process",
  "platform": {
    "os": "linux",
    "arch": "x64",
    "node": ">=22.19"
  }
}
